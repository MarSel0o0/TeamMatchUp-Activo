# Deja VITE_API_URL vacío para trabajar con el backend simulado (mock) en el navegador.
# Cuando el servidor Express esté disponible, apunta aquí a su URL base:
#   VITE_API_URL=/api            -> usa el proxy de Vite (dev)
#   VITE_API_URL=http://localhost:3000/api
VITE_API_URL=

# Target del proxy /api de Vite en desarrollo
VITE_PROXY_TARGET=http://localhost:3000

# Latencia artificial (ms) del mock, para ver los estados de carga
VITE_MOCK_LATENCY=350
