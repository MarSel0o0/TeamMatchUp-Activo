# Plantilla de configuración de la interfaz. Copia este archivo a `.env` si necesitas cambiar algo.
# Ningún valor de aquí es un secreto.

# Dirección base del servidor. `/api` usa el proxy de Vite en desarrollo.
VITE_API_URL=/api

# Backend simulado en memoria (sin servidor). Solo es el texto exacto `true`; cualquier otro
# valor (`TRUE`, `1`, vacío) o dejarlo sin definir usa el servidor real.
VITE_USE_MOCK_API=false

# Destino del proxy /api de Vite en desarrollo (debe coincidir con PORT de backend/.env.example)
VITE_PROXY_TARGET=http://localhost:3001

# Latencia artificial (ms) del backend simulado, para ver los estados de carga
VITE_MOCK_LATENCY=350
