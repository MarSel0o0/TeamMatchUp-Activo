# Interface configuration template. Copy this file to `.env` if you need to change something.
# No value here is a secret.

# Server base address. `/api` uses the Vite proxy in development.
VITE_API_URL=/api

# In-memory simulated backend (no server). Only the exact text `true` enables it; any other
# value (`TRUE`, `1`, empty) or leaving it undefined uses the real server.
VITE_USE_MOCK_API=false

# Target of Vite's /api proxy in development (must match PORT in backend/.env.example)
VITE_PROXY_TARGET=http://localhost:3001

# Artificial latency (ms) of the simulated backend, to see the loading states
VITE_MOCK_LATENCY=350
