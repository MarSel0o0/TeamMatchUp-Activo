NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DBNAME=teammatchup
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
TEST_MONGODB_DBNAME=teammatchup_test
# Valor de desarrollo, NO secreto: sirve en desarrollo y prueba; en producción el servidor
# no arranca con él. Para producción, generar uno propio: openssl rand -hex 32
JWT_SECRET=solo-desarrollo-no-usar-en-produccion
# Opcional: dirección de escucha (ej. 0.0.0.0 en el servidor del curso).
# Vacía o comentada: escucha en todas las interfaces.
# HOST=0.0.0.0
# Opcionales (spec 013, verificar la cuenta de CS2 con Steam). Sin STEAM_API_KEY, la
# verificación con Steam no se ofrece y todo lo demás funciona igual.
# Clave de la API web de Steam (https://steamcommunity.com/dev/apikey): es un secreto, va solo
# en el .env de cada instancia y nunca se sube al repositorio.
# STEAM_API_KEY=
# Dirección con que el navegador abre esta instancia (sin ruta ni barra final); Steam devuelve
# al usuario aquí. Obligatoria si hay clave; en producción debe ser https. Ejemplos:
#   desarrollo local (Vite): http://localhost:5173
#   servidor del curso:      https://fullstack.dcc.uchile.cl:7041
# PUBLIC_URL=
